# Folder for all server data files; on a host, a permanent disk (see docs/DEPLOY.md).
CROWNIQ_DATA_DIR=tmp
# Server only. Copy to apps/api/.env locally. Never put API keys in Expo.
API_HOST=127.0.0.1
API_PORT=3000
ADMIN_TOKEN=
ODDS_PROVIDER=auto
# Lines from Apify scrapers instead of The Odds API: set ODDS_PROVIDER=scrapers and APIFY_TOKEN.
# Pulls run at these Eastern hours, under a daily USD cap; the board reads stored lines for free.
APIFY_TOKEN=
CROWNIQ_SCRAPER_HOURS_ZEN_PRIZEPICKS=9,12,15,18
CROWNIQ_SCRAPER_HOURS_LERGASSY=12
CROWNIQ_SCRAPER_HOURS_ZEN_UNDERDOG=9,12,15,18
CROWNIQ_SCRAPER_HOURS_ZEN_PICK6=9,12,15,18
# The Odds API joins as a third PrizePicks source when THE_ODDS_API_KEY is set. It spends Odds API credits,
# so it runs only on the owner's pull unless hours are set here.
CROWNIQ_SCRAPER_HOURS_ODDS_API=
CROWNIQ_SCRAPER_DAILY_USD=20
# Display-only game context (never scored), on the same daily cap: injuries, Pinnacle game lines, Kalshi, Polymarket.
CROWNIQ_CONTEXT_HOURS_INJURIES=8,11,14,17
CROWNIQ_CONTEXT_HOURS_PINNACLE=9,15
CROWNIQ_CONTEXT_HOURS_KALSHI=11
CROWNIQ_CONTEXT_HOURS_POLYMARKET=11
CROWNIQ_CONTEXT_FEEDS_FILE=tmp/context-feeds.json
# DraftKings and Hard Rock prop prices from SharpAPI (reference odds and CrownIQ's own +EV, never scored), refreshed hourly.
SHARPAPI_KEY=
# (sharp_api is accepted as the same key.)
CROWNIQ_SHARP_PROPS_FILE=tmp/sharp-props.json
# Break-even chance per pick for +EV; default 0.5421 (PrizePicks 5-6 pick Flex).
CROWNIQ_EV_BREAK_EVEN=0.5421
# What the books said about each board line, hourly, for measuring a future "books agree" GKR factor.
CROWNIQ_BOOKS_HISTORY_FILE=tmp/books-history.jsonl
CROWNIQ_SCRAPER_MAX_RUN_USD=5
THE_ODDS_API_KEY=
THE_ODDS_API_SCOPE=full
THE_ODDS_API_MARKETS=player_pass_yds,player_pass_yds_alternate
THE_ODDS_API_MAX_EVENTS=5000
THE_ODDS_API_MAX_CREDITS_PER_REFRESH=10000
SPORTSGAMEODDS_API_KEY=
# auto runs every web-research provider with a key (ChatGPT and Claude side by side); also openai_web, claude_web, both, none.
RESEARCH_PROVIDER=auto
AI_API_KEY=
OPENAI_API_KEY=
# Claude web research, next to ChatGPT. Findings are display-only, like ChatGPT's.
ANTHROPIC_API_KEY=
CLAUDE_RESEARCH_MODEL=claude-opus-5-5
CROWNIQ_CLAUDE_RESEARCH_CATALOG_FILE=tmp/research-catalog-claude.json
# Private, owner-only stat-api Pro research. Never set these in Expo.
STAT_API_KEY=
# Copy the publicId from your own CrownIQ signed-in profile, not an email/username.
CROWNIQ_OWNER_PUBLIC_ID=
# Owner-only notebook auto-refreshes explicitly watched players, not full leagues.
CROWNIQ_OWNER_RESEARCH_FILE=tmp/owner-stat-research.json
CROWNIQ_OWNER_RESEARCH_REFRESH_MINUTES=60
# Maximum provider rows returned per UTC day by this one API process.
CROWNIQ_STAT_API_DAILY_RECORD_LIMIT=100000
# Opt-in: build deterministic historical projection/factor evidence for supported NFL/NBA/MLB markets.
# This uses Stat API quota but never Odds API credits and never fabricates lineup/injury/weather status.
GKR_STAT_EVIDENCE=false
GKR_STAT_EVIDENCE_MAX_PLAYERS=1500
GKR_STAT_EVIDENCE_CONCURRENCY=6
# Fresh pregame context used only during targeted Second Look. MLB uses the official MLB
# Stats API; NFL uses the public structured Sleeper player-status feed; NBA reuses STAT_API_KEY.
GKR_CURRENT_CONTEXT=true
# Key-free public NFL history/status evidence for passing yards, attempts and completions.
# Enabled by default; set false to disable all external public NFL research during reanalysis.
GKR_PUBLIC_NFL_EVIDENCE=true
# Free team and headshot lookup for every team sport (Sleeper NFL, ESPN rosters); display only, never scored.
GKR_PLAYER_IDENTITY=true
# Free scheduled context refresh (local history, player identity, free NFL/MLB status feeds).
# Never spends Odds API credits. 0 minutes turns it off. Only games starting within the window are refreshed.
CROWNIQ_CONTEXT_REFRESH_MINUTES=15
CROWNIQ_CONTEXT_WINDOW_HOURS=8
# Stat API NBA status lookups allowed per UTC day from refresh ticks (0 leaves NBA out of ticks).
CROWNIQ_CONTEXT_NBA_DAILY_LOOKUPS=0
# Optional: refuse public Crowns built from an odds snapshot older than this many minutes (0 = off;
# lines otherwise stay usable until their event starts).
CROWNIQ_SOCIAL_MAX_SNAPSHOT_MINUTES=0
WEB_RESEARCH_MODEL=gpt-5.4-mini
WEB_RESEARCH_MAX_SEARCHES=1500
WEB_RESEARCH_CONCURRENCY=4
CROWNIQ_RESEARCH_CATALOG_FILE=tmp/research-catalog.json
DATABASE_URL=
# Model activation preset. "custom" uses only GKR_APPROVED_MODEL_VERSIONS.
# "stat_history_v1" activates the 20 NFL/NBA/MLB markets backed by the internal/Stat API
# history pipeline while preserving every existing hard current-status gate.
GKR_MODEL_PRESET=custom
# Exact comma-separated GKR model versions additionally approved by the owner.
GKR_APPROVED_MODEL_VERSIONS=
# Optional NFL passing pilot. Files stay on the server, outside Expo.
NFL_PASSING_EVIDENCE_FILE=
NFLVERSE_MAPPING_FILE=
CROWNIQ_SELECTIONS_FILE=
# Durable server-side snapshots. Mount a persistent volume in deployment.
CROWNIQ_BOARD_CACHE_FILE=tmp/board-cache.json
# Last paid-pull job record (status, credits spent); reports pulls interrupted by a restart.
CROWNIQ_OWNER_JOB_FILE=tmp/owner-pull-job.json
# Crown correlation rules for saving and sharing Crowns: conservative (default) or none (saves stay disabled).
CROWNIQ_CROWN_CORRELATION_POLICY=conservative
CROWNIQ_PRODUCT_LEDGER_FILE=tmp/product-ledger.json
# Durable CrownIQ-owned historical observations. Seed backfills and live graded outcomes stay separate.
CROWNIQ_INTERNAL_HISTORY_FILE=tmp/internal-history.json
# Account profiles use the same durable product ledger; private user picks are server-owned.
# Add the HTTPS web app origin when hosting the browser/PWA client (comma-separated).
CROWNIQ_ALLOWED_WEB_ORIGINS=
# Shared guest link for testers (https://<server>/?guest=<code>): each device gets its own account, no username.
CROWNIQ_GUEST_PASS_CODE=
CROWNIQ_GUEST_PASS_MAX=4
CROWNIQ_GUEST_PASS_DAYS=3
# Optional OIDC identity-token verification, server-only. Requires native mobile provider setup.
CROWNIQ_GOOGLE_CLIENT_IDS=
CROWNIQ_APPLE_CLIENT_IDS=
# CROWN_STRONG (default) or PLAYABLE. PASS is never auto-tracked.
CROWNIQ_AUTO_TRACK_MIN_BAND=CROWN_STRONG
# Optional NFL passing-results worker; requires explicit NFLVERSE_MAPPING_FILE.
CROWNIQ_NFLVERSE_AUTO_GRADE=false
